	<!-- Text files macOS has no type for (each extension would otherwise get
	     a dynamic type): source code, configuration, text documents and JSON
	     variants. Imported, so a type another app exports for an extension
	     wins. Extensions macOS already gives another type (.exs Logic, .mts
	     video, .mod, .edn) are left out. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
