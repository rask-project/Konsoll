	<!-- Inserted into the editor's Info.plist (cmake/EditorInfo.plist.in) when
	     KONSOLL_FINDER_INTEGRATION is on (CMakeLists.txt). -->

	<!-- Alternate everywhere: offered in Open With, never the default until
	     the user picks it (Get Info ▸ Change All, or File ▸ Use as Default
	     Editor, which sets every "Text" type: EditorMode::makeDefaultEditor).
	     "Text" is the text types macOS declares, less those another app
	     edits better (playlists, calendars, 3D models, signed profiles, Xcode's
	     Interface Builder files, diagnostic reports), plus the imported types
	     below. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Text</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
