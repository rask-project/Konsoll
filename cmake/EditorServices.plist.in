	<!-- Inserted into the editor's Info.plist (cmake/EditorInfo.plist.in)
	     when KONSOLL_FINDER_INTEGRATION is on (CMakeLists.txt). Finder's
	     context menu for a folder (and Services in other apps for a selected
	     path): EditorMode's provider, in the editor's own process. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Open in ${KONSOLL_EDITOR_BUNDLE_NAME}</string>
			</dict>
			<key>NSMessage</key>
			<string>openInEditor</string>
			<key>NSPortName</key>
			<string>${KONSOLL_EDITOR_BUNDLE_NAME}</string>
			<key>NSRequiredContext</key>
			<dict>
				<key>NSTextContent</key>
				<string>FilePath</string>
			</dict>
			<key>NSSendTypes</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
	</array>

