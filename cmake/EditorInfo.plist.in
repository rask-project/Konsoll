<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Neovim (Konsoll): the helper bundle in Konsoll.app/Contents/Helpers that
     runs Konsoll's executable as a Neovim app (EditorMode). A bundle id of
     its own gives it its own name and icon in the Dock and in Open With. -->
<plist version="1.0">
<dict>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<key>CFBundleName</key>
	<string>${KONSOLL_EDITOR_BUNDLE_NAME}</string>
	<key>CFBundleDisplayName</key>
	<string>${KONSOLL_EDITOR_BUNDLE_NAME}</string>
	<key>CFBundleIdentifier</key>
	<string>${KONSOLL_EDITOR_BUNDLE_ID}</string>
	<key>CFBundleExecutable</key>
	<string>konsoll</string>

	<key>CFBundleVersion</key>
	<string>${KONSOLL_BUNDLE_VERSION}</string>
	<key>CFBundleShortVersionString</key>
	<string>${KONSOLL_DISPLAY_VERSION}</string>

	<key>LSMinimumSystemVersion</key>
	<string>${CMAKE_OSX_DEPLOYMENT_TARGET}</string>

	<!-- assets/konsoll-nvim.icon (cmake/AppIcons.cmake). -->
	<key>CFBundleIconFile</key>
	<string>${KONSOLL_EDITOR_ICON_FILE}</string>
	${KONSOLL_EDITOR_ICON_NAME_KEY}

	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>

	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>

${KONSOLL_EDITOR_SERVICES}${KONSOLL_EDITOR_DOCUMENT_TYPES}</dict>
</plist>
